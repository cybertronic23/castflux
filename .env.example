# CastFlux 环境变量配置
# 复制此文件为 .env，填入你的 API Key
# ⚠️ .env 已加入 .gitignore，不会提交到 Git

# 必需：HuggingFace Token（用于说话人分离模型下载）
HF_TOKEN=hf_你的token

# 至少设置一个 LLM 提供商 Key（默认 DeepSeek）
DEEPSEEK_API_KEY=sk-你的deepseek密钥
# QWEN_API_KEY=你的qwen密钥
# GLM_API_KEY=你的glm密钥
# MINIMAX_API_KEY=你的minimax密钥
# OPENAI_API_KEY=sk-你的openai密钥

# 可选：LLM 提供商配置
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
